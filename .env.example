# Issue this token for your deployed HTTPS origin, then set it in the host's build environment.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Vercel Blob's server-only token authorizes browser-direct project media uploads.
BLOB_READ_WRITE_TOKEN=

# Each direct source upload is constrained to this size (default: 5 GB).
OPENCAST_MAX_SOURCE_GB=5

# Browser-visible media-worker origin for large source transcription. Deploy ./worker separately.
NEXT_PUBLIC_OPENCAST_MEDIA_WORKER_URL=

# Server-only: used by the small-file fallback transcription endpoint. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# The small-file fallback cap, in MB. Long HD sources use the media worker instead.
OPENCAST_MAX_UPLOAD_MB=25
