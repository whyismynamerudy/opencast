# Issue this token for your deployed HTTPS origin, then set it in the host's build environment.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Vercel Blob's server-only token authorizes browser-direct project media uploads.
BLOB_READ_WRITE_TOKEN=

# Each direct source upload is constrained to this size (default: 5 GB).
OPENCAST_MAX_SOURCE_GB=5

# Browser-visible media-worker origin. Deploy ./worker separately.
NEXT_PUBLIC_OPENCAST_MEDIA_WORKER_URL=

# A random shared secret. Set the identical value in Vercel and the Fly worker;
# Vercel uses it to issue short-lived worker job tickets.
OPENCAST_WORKER_SIGNING_SECRET=
