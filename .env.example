# Issue this token for your deployed HTTPS origin, then set it in the host's build environment.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Server-only: OpenAI uses this key for transcript creation. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# A small cap limits accidental spend on an unauthenticated hackathon deployment.
OPENCAST_MAX_UPLOAD_MB=25
